use std::rc::Rc;
use crate::ast::Expr;
use crate::ast::ExprNode;

grammar;

pub Expr: Expr = {
    "\\" <param:Ident> "." <body:Expr> => Rc::new(ExprNode::Abs(param, body)),
    AddExpr,
};

AddExpr: Expr = {
    <a:AddExpr> "+" <b:AppExpr> => Rc::new(ExprNode::Add(a,b)),
    AppExpr,
}

AppExpr: Expr = {
    <f:AppExpr> <a:AtomExpr> => Rc::new(ExprNode::App(f, a)),
    AtomExpr,
};

AtomExpr: Expr = {
    Ident => Rc::new(ExprNode::Var(<>)),
    Num => Rc::new(ExprNode::Num(<>)),
    "(" <Expr> ")",
};

Ident: String = r"[a-zA-Z_][a-zA-Z0-9_]*" => <>.to_string();
Num: i32 = r"[1-9][0-9_]*" => <>.parse().unwrap();
