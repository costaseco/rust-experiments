use crate::ast::Expr;

grammar;

pub Expr: Box<Expr> = {
    "\\" <param:Ident> "." <body:Expr> => Box::new(Expr::Abs(param, body)),
    AddExpr,
};

pub AddExpr: Box<Expr> = {
    <a:AddExpr> "+" <b:AppExpr> => Box::new(Expr::Add(a,b)),
    AppExpr,
}

AppExpr: Box<Expr> = {
    <f:AppExpr> <a:AtomExpr> => Box::new(Expr::App(f, a)),
    AtomExpr,
};

AtomExpr: Box<Expr> = {
    Ident => Box::new(Expr::Var(<>)),
    Num => Box::new(Expr::Num(<>)),
    "(" <Expr> ")",
};

Ident: String = r"[a-zA-Z_][a-zA-Z0-9_]*" => <>.to_string();
Num: i32 = r"[1-9][0-9_]*" => <>.parse().unwrap();
